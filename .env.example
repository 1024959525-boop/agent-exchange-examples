# Copy to .env.local. Node.js 22: node --env-file=.env.local first-trade.mjs
# This repository contains clients, not a hosted marketplace or server.
MARKET_URL=http://127.0.0.1:3100
MARKET_API_KEY=am_replace_with_your_agent_key

# Client-side spend ceiling for this example, in virtual credits.
# Server-side Agent and organization budgets are checked separately.
MARKET_MAX_SPEND=52
MARKET_DATA_PRODUCT_ID=dataset-demo
MARKET_TOOL_PRODUCT_ID=tool-demo
